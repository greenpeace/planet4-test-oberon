{
	"name": "greenpeace/planet4-test-oberon",
	"description": "Greenpeace P4 test-oberon",
	"license": "MIT",
	"require": {
		"greenpeace/planet4-master-theme": "7"
	},
	"repositories": [
		{
			"type": "package",
			"package": {
				"name": "greenpeace/planet4-master-theme",
				"type": "wordpress-theme",
				"autoload": {
					"psr-4": {
						"P4\\MasterTheme\\": "src/"
					}
				},
				"extra": null,
				"version": 7,
				"dist": {
					"type": "zip",
					"url": "https://storage.googleapis.com/planet4-packages/planet4-master-theme/7ab3e97333daa6507685164d0de8399cc6a38723.zip"
				}
			}
		}
	],
	"scripts": {
		"install:gravityforms": "wp plugin install --force --activate https://storage.googleapis.com/planet4-3rdparty-plugins/gravityforms_3.1.1.2.zip",
		"site:custom": [
			"@install:gravityforms"
		]
	}
}
